# ===== 自带 Python 便携运行时（整目录 ~500MB，不入库）=====
runtime/

# ===== 大型模型权重（不入库，README 说明下载来源）=====
# 说明：rmvpe.pt（~173MB）等大文件均走"下载获取"，不在仓库里。
#       各文件的下载来源见 README「模型文件获取」一节。
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
*.onnx

# ===== MSST 外部回退模型（本地缓存，不入库）=====
msst/pretrain/*.ckpt
msst/pretrain/*.yaml

# ===== UVR5 自动下载的分离模型（首次运行自动拉取）=====
uvr5/uvr_model/*.pth
uvr5/uvr_model/*.json

